{
  "name": "knowledge-tree-base",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tag-indexed knowledge tree: React frontend, Node.js backend, SQLite storage, MCP + CLI tools",
  "bin": {
    "kt": "bin/kt.js"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.js",
    "mcp": "node mcp/server.js",
    "seed": "node scripts/seed.js",
    "check": "node bin/kt.js check",
    "test": "node --test test/"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "vite": "^5.4.21"
  }
}
