# The BUILD image: everything needed to compile and build the knowledge tree,
# and nothing that has to be present to run it.
#
# The source is COPYed from this repository (build context: kt/). It is not
# cloned from anywhere -- the tree is this project's own code now, so a
# checkout of this repository is the only thing the build depends on.
#
# NODE IS THE LATEST LTS, installed from nodejs.org, not from the Ubuntu
# archive. The archive's node is 18.19, which reached end of life in April
# 2025 -- taking the distribution's version meant shipping an unsupported
# runtime, and pinning `better-sqlite3` and `vite` to keep it. Upstream is not
# a "third-party apt repository": it is the project's own release, verified
# here against its own SHASUMS256.txt, and `NODE_VERSION` pins it so the image
# is reproducible. Raise it deliberately, and re-measure.
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# v26.13.1 is the newest release of the Lithium line, which is the current LTS
# as of 2026-11-28 (nodejs.org/dist/index.json).
ARG NODE_VERSION=26.13.1

# python3/make/g++ are here because better-sqlite3 is a native module and
# compiles from source when no prebuilt binary matches the image's Node.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl xz-utils python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

# Node from upstream, checksum-verified. The tarball unpacks into /usr/local,
# so `node` and `npm` land on PATH with no version manager; the run image
# copies the single binary out of here rather than installing anything.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      amd64) arch=x64 ;; \
      arm64) arch=arm64 ;; \
      *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    tarball="node-v${NODE_VERSION}-linux-${arch}.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${tarball}"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
    grep " ${tarball}\$" SHASUMS256.txt | sha256sum -c -; \
    tar -xJf "${tarball}" -C /usr/local --strip-components=1 --no-same-owner; \
    rm "${tarball}" SHASUMS256.txt; \
    node --version; npm --version

WORKDIR /opt/knowledge-tree
# kt/.dockerignore keeps the host's node_modules, dist and data out: a
# host-built native module is compiled against the host's Node ABI.
COPY . .

RUN npm install --no-audit --no-fund

# The gate, inside the image that built it: a run image is not worth starting
# if the tree's invariants do not hold. `npm test` is this same line since
# 2026-11-28; it is spelled out here so the image does not depend on the
# script staying that way.
RUN node --test test/*.test.js

# The read-only viewer. `server/index.js` serves `dist/` when it exists.
RUN npm run build
